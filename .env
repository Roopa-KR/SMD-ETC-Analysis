# Local settings for the Truck ETC app
WORKBOOK_PATH=data/workbook.xlsx
DATABASE_URL=sqlite:///data/truck_etc.db
DEFAULT_SNAPSHOT=10
FLASK_DEBUG=0
# Minutes picking must finish before the pick cutoff (safety buffer deadline = cutoff - buffer)
SAFETY_BUFFER_MINUTES=10
# Planning pace: picking_time (default) or logged_time (original Excel equation)
PACE_BASIS=picking_time
# A gap longer than this between an operator's picks counts as waiting, not picking
PACE_GAP_CAP_MINUTES=10
# Temporary operators: assumed pace as % of the work type's per-person rate (SYNTHESIZED ASSUMPTION)
TEMP_OPERATOR_PACE_PCT=100
# Most temporary operators that can be added to one work type
TEMP_OPERATOR_MAX=10
# ---- v13 Environmental conditions (context only; not used in ETC or allocation) ----
ENV_DATABASE_URL=sqlite:///data/environment.db
# Warehouse local time zone for readings (to be confirmed with the client)
WAREHOUSE_TIMEZONE=America/New_York
# A zone's latest reading older than this is "stale"
ENV_STALE_MINUTES=60
# A registered sensor silent longer than this "requires attention"
ENV_DEVICE_SILENT_MINUTES=30
# Bearer token for POST /api/environment/readings; leave empty to keep the sensor API disabled
ENV_INGEST_TOKEN=
# Optional key required for manual entry and device registration; empty = not required
ENV_ENTRY_KEY=
